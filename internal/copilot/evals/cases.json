  "cases": [
    {"name": "zh-launch", "language": "zh-TW", "board": "empty", "text": "規劃產品上線：寫文件、測試、發布",
     "expect": {"minNodes": 3, "maxNodes": 6, "keywords": [["文件"], ["測試"], ["發布", "上線"]], "order": [[["測試"], ["發布", "上線"]]]}},
    {"name": "zh-after-selection", "language": "zh-TW", "board": "product", "selected": ["n-ui"], "text": "接在這個之後：寫測試、修 bug、上線",
     "expect": {"minNodes": 3, "maxNodes": 5, "keywords": [["測試"], ["bug", "修"], ["上線", "發布"]], "attachesTo": ["n-ui"], "order": [[["測試"], ["上線", "發布"]]]}},
    {"name": "zh-split", "language": "zh-TW", "board": "product", "selected": ["n-docs"], "text": "把選取的節點拆成小步驟",
     "expect": {"minNodes": 2, "maxNodes": 8, "noDuplicateOf": ["n-docs"]}},
    {"name": "zh-no-duplicate", "language": "zh-TW", "board": "product", "text": "加上：登入畫面、忘記密碼、註冊流程",
