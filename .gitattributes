# The repository stores text with LF. Without this, core.autocrlf hands
# Windows checkouts CRLF files, and then `gofmt -l` reports every Go file in
# the tree as unformatted — which buries the ones that really are.
* text=auto eol=lf

*.go     text eol=lf
*.mod    text eol=lf
*.sum    text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.mjs    text eol=lf
*.cjs    text eol=lf
*.json   text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.md     text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.sh     text eol=lf

# PowerShell stays CRLF: it is only ever run on Windows.
*.ps1    text eol=crlf

*.exe    binary
*.dll    binary
*.zip    binary
*.veproj binary
*.docx   binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.icns   binary
*.pdf    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
