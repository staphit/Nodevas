{
  "presets": {
    "light":    {"planner": true, "goalQa": false, "tester": false, "reviewer": false, "ci": false, "goalReview": false},
    "standard": {"planner": true, "goalQa": false, "tester": true,  "reviewer": true,  "ci": false, "goalReview": false},
    "full":     {"planner": true, "goalQa": true,  "tester": true,  "reviewer": true,  "ci": true,  "goalReview": true}
  },
  "presetOrder": ["light", "standard", "full", "custom"],
  "defaults": {
    "maxQaRounds": 2,
    "maxTesterRounds": 2,
    "maxGreenTries": 3,
    "testGlobs": ["**/*_test.go", "**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx", "**/test/**", "**/tests/**", "**/__tests__/**", "e2e/**", "**/test_*.py", "**/*_test.py"]
  },
  "bounds": {
    "reviewerSkipBelowLines": [0, 10000],
    "maxQaRounds": [1, 5],
    "maxTesterRounds": [1, 3],
    "maxGreenTries": [1, 5],
    "testGlobs": 32
  },
  "newProject": {
    "workflow": {"preset": "standard", "judge": ""},
    "story": {"preset": "standard", "judge": "checklist"}
  },
  "weights": {
    "executor": 1.0,
    "tester": 0.5,
    "verify": 0,
    "reviewer": 0.5,
    "revise": 0.3,
    "ci": 0,
    "ciFix": 0.3,
    "goalQa": 0.5,
    "storyJudge": 0.3,
    "planner": 1.0,
    "smallDiffShare": 0.3
  },
  "costFormula": "executor + (tester ? (judge=='checklist' ? storyJudge : tester) : 0) + (reviewer ? reviewer - (reviewerSkipBelowLines>0 ? reviewer*smallDiffShare : 0) : 0) + ((tester||reviewer) ? revise : 0) + (goalQa ? goalQa : 0) + (ci ? ciFix : 0); planner is shown separately",
  "expectedCost": {"light": 1.0, "standard": 2.3, "full": 3.1},
  "hintBands": [
    {"max": 1.5, "label": "1×"},
    {"max": 3.0, "label": "≈2–3×"},
    {"max": 99, "label": "≈3–4×"}
  ]
}
