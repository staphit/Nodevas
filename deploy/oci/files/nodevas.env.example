# Environment for nodevas.service. Copy to /etc/nodevas/nodevas.env.
#
# The real file must be 0600 and owned by root:root, because it holds the SMTP
# password in cleartext. systemd reads EnvironmentFile as PID 1 before it drops
# to the nodevas user, so the service account never needs read access to it —
# and should not have it, since that account is the one exposed to the network.
#
#   install -o root -g root -m 0600 nodevas.env.example /etc/nodevas/nodevas.env
#
# Every variable below must have a value. The unit passes them straight into
# flags, and systemd substitutes an unset variable with an empty argument: a
# blank NODEVAS_SMTP_PORT becomes `--smtp-port ""` and the server exits on a
# flag parse error rather than starting with a default.

# ---------------------------------------------------------------------------
# Identity on the network
# ---------------------------------------------------------------------------

# The public name this server answers on, passed to --hostname and used by the
# Caddyfile as the site address. sslip.io resolves 1-2-3-4.sslip.io to 1.2.3.4,
# so this is the instance's public IP with dots replaced by dashes.
#
# This is not cosmetic. The server rejects any request whose Host header is not
# a name it was told about, which is what stops a page on an attacker-controlled
# domain pointed at this IP from producing a Host and Origin that agree. Get it
# wrong and every request through the proxy is a 403.
#
# If the instance's public IP changes, this value and the copy in
# /etc/caddy/caddy.env both have to change, and Caddy has to issue a new
# certificate for the new name.
NODEVAS_HOSTNAME=203-0-113-10.sslip.io

# The loopback port Caddy proxies to. Only ever reachable from this host, so
# the number matters solely because it must match NODEVAS_UPSTREAM in
# /etc/caddy/caddy.env.
NODEVAS_PORT=5666

# ---------------------------------------------------------------------------
# Outgoing mail — without this, nobody can sign in
# ---------------------------------------------------------------------------
#
# Signing in to the web UI takes two factors: a PIN an administrator issues with
# `nodevas user pin`, and a one-time passcode mailed to that account's address.
# A server with accounts and no working relay hands out no passcodes and
# therefore admits nobody. It starts, it serves the login page, and every
# attempt fails in a way that looks like mail that never arrived. The server
# says so at startup — grep the journal for "nobody can sign in".
#
# Note for Oracle Cloud specifically: outbound port 25 is blocked on new
# tenancies and asking for it to be opened is a support request. 587 (STARTTLS)
# and 465 (implicit TLS) are the ports that work, which is why the default here
# is 587 and not 25.

# Relay hostname. Empty disables passcode mail entirely, which on a networked
# deployment means disabling sign-in.
NODEVAS_SMTP_HOST=smtp.example.com

# 587 for STARTTLS, 465 for implicit TLS. Must match NODEVAS_SMTP_SECURITY.
NODEVAS_SMTP_PORT=587

# starttls, implicit, or none. `none` is refused unless the relay is on
# loopback, because a passcode is a credential and this hop leaves the machine.
NODEVAS_SMTP_SECURITY=starttls

# The account this server authenticates to the relay as.
NODEVAS_SMTP_USER=nodevas@example.com

# The From address on passcode mail. A display name is fine — systemd passes
# the whole value as one argument, spaces and angle brackets included.
# Deliverability is the point of getting this right: a passcode that lands in
# spam is indistinguishable from one that was never sent.
NODEVAS_SMTP_FROM="Nodevas <no-reply@example.com>"

# The relay password. This is the reason this file is 0600 root:root. It is an
# environment variable and never a flag: a flag is in /proc/<pid>/cmdline for
# every account on the machine and in the shell history of whoever typed it.
NODEVAS_SMTP_PASSWORD=replace-me

# ---------------------------------------------------------------------------
# Visitor access
# ---------------------------------------------------------------------------
#
# There is nothing to set here. The shared read-only credential lives in the
# workspace database, not in this file, so that turning it off does not mean
# restarting the service and dropping everyone's editing session:
#
#   nodevas visitor show --project /var/lib/nodevas/workspace
#   nodevas visitor on   --project /var/lib/nodevas/workspace --pin 777
#   nodevas visitor off  --project /var/lib/nodevas/workspace
#
# Run them as the nodevas user with XDG_CONFIG_HOME set the way the unit sets
# it. A running server picks the change up on the next sign-in attempt.
#
# Understand what it is before turning it on. It is a published password: both
# halves admit anyone who knows them to read every project on this server.
# There is no per-person accountability behind it — every visitor is the same
# actor in the audit trail — and no way to revoke one visitor without revoking
# all of them. Visitors may copy or save every document and attachment they can
# see. They cannot write, upload, bulk-export, administer the server, browse the
# host filesystem, or use the operator's remote integrations.

# ---------------------------------------------------------------------------
# Limits and logging
# ---------------------------------------------------------------------------

# How many distinct accounts may hold a session at once; 0 is no limit. It
# counts people, not devices — one person on a laptop and a phone is one. On
# the 1 GB micro shape a small number here is a memory ceiling expressed in
# users, which is easier to reason about than MemoryMax.
# Visitors are not counted. The limit exists to bound how many people have work
# open at once, and a visitor has none — counting them would let anyone holding
# the shared PIN fill the server and lock the editors out, which is the one
# thing a read-only credential must not be able to do.
NODEVAS_MAX_ACTIVE_USERS=4

# debug, info, warn, or error. debug logs every request body decision and is
# worth turning on only while chasing something; it is also the setting most
# likely to put something interesting into a log that leaves this machine.
NODEVAS_LOG_LEVEL=info

# The log format is fixed at json in the unit file rather than set here: the
# destination is journald and then a shipper, and `text` is for a terminal.
# Alert on event.code=audit.persistence_fallback. Audit is availability-first:
# a successful content mutation is not rolled back when the separate audit DB
# write fails, so retain and reconcile the structured fallback event. Database
# recovery alone does not clear overall health; an admin must acknowledge the
# exact reconciled fallbackEvents counter through the protected health API.

# ---------------------------------------------------------------------------
# Optional: encryption of the stored cloud-backup credentials
# ---------------------------------------------------------------------------

# Base64 of 32 random bytes, used to encrypt the Google Drive token at rest. If
# unset, the server generates a machine-local key under XDG_CONFIG_HOME
# (/var/lib/nodevas/config/nodevas/secrets/master.key), which is on the block
# volume and therefore survives an instance rebuild — set this explicitly only
# if you want to restore that state onto a *different* machine.
#
#   openssl rand -base64 32
#
# NODEVAS_SECRET_KEY=

# Google Drive backup OAuth client. Enter these through the authenticated App
# settings page on the deployed server; credentials are encrypted in the
# server's secrets store. These variables are intentionally not read by the
# runtime and are shown only as a reminder of the values the UI needs.
#
# NODEVAS_GOOGLE_CLIENT_ID=
# NODEVAS_GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Deliberately absent
# ---------------------------------------------------------------------------
#
# NODEVAS_PASSWORD is read by `nodevas user add` as a fallback source for an
# account password. It has no business in a service environment file: putting
# it here would place a user's password in the server's own environment, where
# anything that can read /proc/<pid>/environ can read it, for the entire life
# of the process. Pipe passwords in with --password-stdin instead.
