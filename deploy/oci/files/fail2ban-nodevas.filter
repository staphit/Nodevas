# fail2ban filter for the Nodevas server's own request log.
#
# Install to /etc/fail2ban/filter.d/nodevas.conf.
#
# The source is the journal rather than a web-server access log, and that is
# the point. Nodevas writes one ECS JSON object per request (internal/logging)
# containing the method, the path, the status every middleware settled on, and
# a client address already resolved through the trusted-proxy rules in one
# place. A Caddy access log would be the same requests recorded twice,
# disagreeing about who the client was — Caddy sees the TCP peer, and behind a
# proxy that is not the client.
#
# What is matched is the sign-in surface only. Everything under /api/ answers
# 401 to an unauthenticated caller, so banning on 401 generally would ban a
# browser whose session expired in a background tab. These two endpoints are
# the ones where a 401 means a credential was offered and refused.

[Definition]

# Lookaheads rather than one left-to-right pattern: slog does not promise a
# field order, and a regex that depends on one silently stops matching after an
# unrelated change to what is logged. Each condition is stated independently
# and the line has to satisfy all of them.
#
#   401  the PIN or the passcode was wrong
#   403  refused by a transport guard — a cross-origin or cross-site POST at
#        the login endpoint is not a person mistyping
#   429  the throttle already fired; repeatedly reaching it is the behaviour
#        this jail exists to stop, not a reason to forgive it
#
# 202 is deliberately absent. The passcode endpoint answers 202 for a PIN that
# does not exist precisely so it cannot be used to enumerate PINs, and matching
# on it here would rebuild that oracle out of the ban list.
failregex = ^(?=.*"url\.path":"/api/auth/(?:login|otp/request)")(?=.*"http\.response\.status_code":(?:401|403|429))(?=.*"client\.ip":"<HOST>").*$

# Nothing is ignored at the pattern level. Addresses that must never be banned
# belong in ignoreip in the jail, where an operator can see the whole list in
# one place instead of discovering it in a regex.
ignoreregex =

# Only this unit's records. Without it the filter reads the whole journal, and
# any other service that happens to log a matching string would ban addresses
# on behalf of an application that never saw them.
journalmatch = _SYSTEMD_UNIT=nodevas.service

[Init]
# The records are JSON on one line; nothing here spans lines.
maxlines = 1
